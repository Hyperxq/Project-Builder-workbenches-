{
  "$schema": "./node_modules/@pbuilder/sdk/schemas/project-builder.schema.json",
  "collections": {
    "default": {
      "crud-routes": {
        "path": "./schematics/crud-routes"
      },
      "entity-data-layer": {
        "path": "./schematics/entity-data-layer"
      },
      "mock-domain-register": {
        "path": "./schematics/mock-domain-register"
      },
      "overview-card": {
        "path": "./schematics/overview-card"
      },
      "sidebar-nav-entry": {
        "path": "./schematics/sidebar-nav-entry"
      }
    }
  },
  "dependencies": {},
  "settings": {
    "autoInstall": true,
    "conflictPolicy": "child-wins",
    "depValidation": "dev"
