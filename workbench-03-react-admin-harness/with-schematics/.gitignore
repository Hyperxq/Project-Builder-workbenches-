# Benchmark run output — generated during measured runs, never committed.
# The generated entity modules ARE the experiment result; only the starting
# state (reference module + harness) is tracked. Clean a finished experiment
# with: git checkout -- <arm> && git clean -fdx <arm>
src/routeTree.gen.ts
schematics/*
!schematics/.gitkeep
src/features/*/
!src/features/authors/
src/routes/*/
!src/routes/authors/
mocks/domains/*
!mocks/domains/authors.mock.ts
!mocks/domains/authors.mock.spec.ts
mocks/fixtures/*
!mocks/fixtures/authors.fixture.ts
e2e/*
!e2e/authors.spec.ts
