# Base variables for local development. Committed to the repo so
# every clone works out of the box.
#
# Mock-mode flags (VITE_ENABLE_MOCKING, VITE_MSW_OMIT_KEYS) are
# injected per-script via cross-env in package.json — not from a
# .env file. That keeps the intent visible in the script name and
# makes CI/pipeline overrides trivial.
#
# Per-machine overrides go in .env.development.local (gitignored).

VITE_API_BASE=/api
