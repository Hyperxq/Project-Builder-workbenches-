meta {
  name: Remove Author
  type: graphql
  seq: 5
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation RemoveAuthor($getAuthor: GetAuthorInput!) {
    removeAuthor(getAuthor: $getAuthor) {
      authorId
      fullName
      email
    }
  }
}

body:graphql:vars {
  {
    "getAuthor": {
      "authorId": 1
    }
  }
}
