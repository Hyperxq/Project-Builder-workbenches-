meta {
  name: Create Author
  type: graphql
  seq: 1
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation CreateAuthor($createAuthor: CreateAuthorInput!) {
    createAuthor(createAuthor: $createAuthor) {
      authorId
      fullName
      email
      country
      active
    }
  }
}

body:graphql:vars {
  {
    "createAuthor": {
      "authorId": 1,
      "fullName": "Ada Lovelace",
      "email": "ada@example.com",
      "country": "United Kingdom",
      "active": true
    }
  }
}
